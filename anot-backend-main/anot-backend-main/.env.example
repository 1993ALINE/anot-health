# Copy to .env and adjust for local development.
# Required: JWT_SECRET (server exits if missing).
# Database: set DATABASE_URL *or* DB_* (see src/config/db.js).

NODE_ENV=development
PORT=5000
BIND_HOST=0.0.0.0

# ─── SECRETS SOURCE (SSM vs .env) ──────────────────────────────────────────────
# v40+: secrets can be loaded from AWS SSM Parameter Store at boot instead of
# being baked into .env / EB environment properties. See src/config/loadSecrets.js.
#
# LOCAL DEV (default): leave USE_SSM unset/false — everything below is read from
# this .env file exactly as before. No AWS credentials or network needed.
#
# PRODUCTION (Elastic Beanstalk): set USE_SSM=true. At boot the app pages through
# every SecureString/String under SSM_PREFIX, decrypts them (KMS), and copies
# them into process.env (overriding values here). The EC2 instance profile must
# allow ssm:GetParametersByPath + kms:Decrypt on those parameters.
#   Account: 625242092266   Region: ap-southeast-1   Prefix: /anot/prod
# USE_SSM=false
# SSM_REGION=ap-southeast-1
# SSM_PREFIX=/anot/prod
# SSM_OPTIONAL=false       # true => boot from .env if SSM fetch fails (NOT for prod)
# SSM_NO_OVERRIDE=false    # true => keep pre-set env vars instead of SSM values

# Required — at least 16 characters recommended for production
JWT_SECRET=change-me-to-a-long-random-dev-secret
JWT_EXPIRES_IN=8h

# Database — Style A (cloud / URL) OR Style B (local discrete vars)
# DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/anot_dev

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=anot_dev
DB_USER=anot_dev
DB_PASSWORD=your_local_db_password
# DB_SSL=true

# TLS to the database (PHI in transit must be encrypted AND verified).
# Production (RDS): set DB_SSL_CA to the Amazon RDS CA bundle so the server cert
# is verified against AWS's CA. The Docker image downloads it to /opt/rds/rds-ca.pem
# and sets DB_SSL_CA automatically — only set this when running outside the image.
#   Download: https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
# DB_SSL_CA=/opt/rds/rds-ca.pem
# IMPORTANT: do NOT put sslmode=... in DATABASE_URL — db.js strips it, but keep the
# URL clean (e.g. postgres://user:pass@host:5432/anot, no ?sslmode=verify-full).
#
# Escape hatch ONLY (local debugging) — encrypt without verifying the cert. Never
# use in production; prefer DB_SSL_CA.
# DB_SSL_NO_VERIFY=true

# Optional — reverse proxy / deployment
# TRUST_PROXY=0
# RAILWAY_ENVIRONMENT=
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Optional — Redis-backed rate limiting (production). Falls back to in-memory when unset.
# REDIS_URL=redis://127.0.0.1:6379

# Optional — error monitoring. Leave unset to use the built-in project DSN,
# set to your own Sentry DSN per environment, or set empty to silence reporting.
# SENTRY_DSN=

# Optional — features (AI draft generation via Anthropic Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# DEEPGRAM_WEBHOOK_SECRET=
# SETTINGS_ENCRYPTION_KEY=
#   ^ Encrypts third-party API keys saved in system_settings (AES-256-GCM).
#     In production this comes from SSM (/anot/prod/SETTINGS_ENCRYPTION_KEY).
#     Rotate with: npm run reencrypt:settings-key  (see scripts/reencrypt-settings-key.js)
# ALLOW_DEV_SEED=true

# Optional — clinician support email (POST /api/support/message).
# Without SMTP_* the message is still accepted + audited, but not emailed.
# SUPPORT_EMAIL=support@anot.health
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
