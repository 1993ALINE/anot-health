# Legacy AL2 hook — on Amazon Linux 2023 (Node.js 22) container_commands are ignored;
# migrations run via .platform/hooks/predeploy/01_run_migrations.sh instead.
# USE_SSM=true (00_env_vars.config) hydrates DB creds via loadSecrets() in run-migrations.js.

option_settings:
  aws:elasticbeanstalk:command:
    Timeout: '600'

container_commands:
  01_run_migrations:
    command: timeout 600 npm run migrate:prod
    leader_only: true
