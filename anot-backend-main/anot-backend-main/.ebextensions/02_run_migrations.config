# Run database migrations once per deployment (leader instance only).
# npm install has completed in /var/app/staging before container_commands run
# on the Node.js platform. USE_SSM=true (00_env_vars.config) hydrates DATABASE_URL
# via scripts/run-migrations.js → loadSecrets().

option_settings:
  aws:elasticbeanstalk:command:
    Timeout: '600'

container_commands:
  01_run_migrations:
    command: timeout 600 npm run migrate:prod
    leader_only: true
