# Rate-limit defaults for Elastic Beanstalk. Override per environment via EB console
# or sync from SSM with: node scripts/sync-rate-limit-config.js
#
# When USE_SSM=true, loadSecrets() hydrates these from SSM Parameter Store at boot
# (SSM values take precedence over the static values below unless SSM_NO_OVERRIDE=true).
#
# Deployment / rolling-update settings (LoadBalanced environments):
#   RollingWithAdditionalBatch keeps capacity during version deploys.
#   If the console already set these via API, update the environment config there
#   once — API-set options take precedence over .ebextensions on existing envs.

option_settings:
  aws:elasticbeanstalk:application:environment:
    USE_SSM: 'true'
    SSM_PREFIX: '/anot/prod'
    SSM_REGION: 'ap-southeast-1'
    RATE_LIMIT_LOGIN_MAX: '5'
    RATE_LIMIT_LOGIN_WINDOW_MINUTES: '15'
    RATE_LIMIT_API_MAX: '100'
    JWT_EXPIRES_IN: '1h'
    RATE_LIMIT_API_WINDOW_MINUTES: '1'
    FFMPEG_MAX_UPLOAD_MB: '500'
    TRUST_PROXY: '1'
  aws:autoscaling:launchconfiguration:
    IamInstanceProfile: aws-elasticbeanstalk-ec2-role
  aws:elasticbeanstalk:command:
    DeploymentPolicy: RollingWithAdditionalBatch
    BatchSizeType: Percentage
    BatchSize: '50'
  aws:autoscaling:updatepolicy:rollingupdate:
    RollingUpdateEnabled: 'true'
