# Rate-limit defaults for Elastic Beanstalk. Override per environment via EB console
# or sync from SSM with: node scripts/sync-rate-limit-config.js
#
# When USE_SSM=true, loadSecrets() hydrates these from SSM Parameter Store at boot
# (SSM values take precedence over the static values below unless SSM_NO_OVERRIDE=true).

option_settings:
  aws:elasticbeanstalk:application:environment:
    USE_SSM: 'true'
    SSM_PREFIX: '/anot/prod'
    SSM_REGION: 'ap-southeast-1'
    RATE_LIMIT_LOGIN_MAX: '10'
    RATE_LIMIT_LOGIN_WINDOW_MINUTES: '15'
    RATE_LIMIT_API_MAX: '200'
    RATE_LIMIT_API_WINDOW_MINUTES: '1'
    TRUST_PROXY: '1'
