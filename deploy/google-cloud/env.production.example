# ─────────────────────────────────────────────────────────────────────────────
# Anot — PRODUCTION environment variables (Google Cloud)
#
# This file documents every variable the backend reads in production. Values
# marked (SECRET) must be stored in Secret Manager and injected with
# `gcloud run deploy --set-secrets=...`, NOT committed or passed as plain
# --set-env-vars. Non-secret values can be passed with --set-env-vars.
#
# Copy to env.production and fill in real values for your records. Do NOT commit
# the filled-in file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
# Cloud Run injects PORT=8080 automatically; do not override it.
# PORT=8080
# Cloud Run sits behind a proxy; the app trusts 1 hop automatically in production.
# TRUST_PROXY=1

# ── Auth (SECRET) ────────────────────────────────────────────────────────────
# Must be >= 16 chars in production (server.js exits otherwise).
# Generate: openssl rand -base64 48
JWT_SECRET=replace-with-secret-manager-value
JWT_EXPIRES_IN=8h

# ── Database — Cloud SQL for PostgreSQL via Cloud Run unix socket ─────────────
# When connecting through --add-cloudsql-instances, use the socket path as host
# and DO NOT set DB_SSL (socket connections are already private/encrypted).
# Socket path format: /cloudsql/PROJECT_ID:REGION:INSTANCE_ID
DB_HOST=/cloudsql/your-project-id:us-central1:anot-postgres
DB_NAME=anot
DB_USER=anot_app
DB_PASSWORD=replace-with-secret-manager-value   # (SECRET)
# DB_PORT is ignored for unix sockets.
# DB_SSL is intentionally unset for the Cloud SQL socket.
#
# Alternative (public IP / external Postgres) — use a single URL instead of DB_*:
# DATABASE_URL=postgresql://anot_app:PASSWORD@HOST:5432/anot   # (SECRET) requires verifiable TLS

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (Firebase Hosting URLs).
CORS_ORIGINS=https://your-app.web.app,https://your-app.firebaseapp.com

# ── AI / transcription ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=replace-with-secret-manager-value          # (SECRET)
DEEPGRAM_WEBHOOK_SECRET=replace-with-secret-manager-value     # (SECRET, optional)

# ── Encryption for stored provider settings ──────────────────────────────────
# Generate: openssl rand -hex 32
SETTINGS_ENCRYPTION_KEY=replace-with-secret-manager-value     # (SECRET)

# ── Error monitoring (optional) ──────────────────────────────────────────────
# Leave unset to use the built-in DSN, set your own, or set empty to silence.
# SENTRY_DSN=

# ── Clinician support email (optional) ───────────────────────────────────────
# SUPPORT_EMAIL=support@anot.health
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=          # (SECRET if set)
# SMTP_FROM=

# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND build-time variable (set when building the Vite app for Firebase).
# This is baked into the static bundle at `npm run build`, not read at runtime.
#   VITE_API_URL=https://<cloud-run-service-url>/api
# ─────────────────────────────────────────────────────────────────────────────
