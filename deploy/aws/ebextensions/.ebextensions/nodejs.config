# ─────────────────────────────────────────────────────────────────────────────
# Elastic Beanstalk configuration for the Anot backend (Node.js on AL2023).
#
# This file must live at the ROOT of the deployment bundle as
# `.ebextensions/nodejs.config`. `setup.sh` copies it into the bundle root
# automatically when it packages the backend; it is kept here under
# deploy/aws/ebextensions/ so it lives with the rest of the AWS deploy assets.
#
# What it does:
#   - Runs the env as a free-tier SingleInstance (no paid load balancer).
#   - Uses a t3.micro EC2 instance (AWS Free Tier eligible).
#   - Wires the EB instance profile + service role.
#   - Sets the nginx proxy and the "/" health check.
#   - Installs a static ffmpeg/ffprobe build (required by
#     src/services/audioProcessingService.js, which spawns `ffmpeg`).
#
# Secrets and per-environment values (DB_HOST, JWT_SECRET, ANTHROPIC_API_KEY,
# CORS_ORIGINS, ...) are NOT set here — `setup.sh` injects them as environment
# properties so they never get committed.
#
# The Node.js platform runs `npm start` (package.json → "node src/server.js"),
# which reads process.env.PORT (EB sets 8080) and binds 0.0.0.0.
# ─────────────────────────────────────────────────────────────────────────────

option_settings:
  aws:elasticbeanstalk:environment:
    EnvironmentType: SingleInstance
    ServiceRole: aws-elasticbeanstalk-service-role
  aws:autoscaling:launchconfiguration:
    IamInstanceProfile: aws-elasticbeanstalk-ec2-role
  aws:ec2:instances:
    InstanceTypes: t3.micro
  aws:elasticbeanstalk:application:
    Application Healthcheck URL: /
  aws:elasticbeanstalk:application:environment:
    NODE_ENV: production
  aws:elasticbeanstalk:environment:proxy:
    ProxyServer: nginx
  aws:elasticbeanstalk:healthreporting:system:
    SystemType: enhanced

# Install ffmpeg + ffprobe (static build) before the app starts. The backend
# spawns the `ffmpeg` binary by name, so it must be on PATH for the node process.
commands:
  01_install_ffmpeg:
    test: test ! -x /usr/local/bin/ffmpeg
    command: |
      set -e
      ARCH="$(uname -m)"
      case "$ARCH" in
        x86_64)  PKG=ffmpeg-release-amd64-static ;;
        aarch64) PKG=ffmpeg-release-arm64-static ;;
        *) echo "Unsupported architecture: $ARCH" >&2; exit 1 ;;
      esac
      cd /tmp
      curl -fsSL "https://johnvansickle.com/ffmpeg/releases/${PKG}.tar.xz" -o ffmpeg.tar.xz
      DIR="$(tar -tf ffmpeg.tar.xz | head -1 | cut -d/ -f1)"
      tar -xf ffmpeg.tar.xz
      install -m 0755 "${DIR}/ffmpeg"  /usr/local/bin/ffmpeg
      install -m 0755 "${DIR}/ffprobe" /usr/local/bin/ffprobe
      # Symlink into /usr/bin too, so it is on PATH for the systemd-managed app.
      ln -sf /usr/local/bin/ffmpeg  /usr/bin/ffmpeg
      ln -sf /usr/local/bin/ffprobe /usr/bin/ffprobe
      rm -rf /tmp/ffmpeg.tar.xz "/tmp/${DIR}"
