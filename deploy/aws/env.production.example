# ─────────────────────────────────────────────────────────────────────────────
# Anot — PRODUCTION environment variables (AWS)
#
# These are the variables the backend reads in production on AWS Elastic
# Beanstalk. Values marked (SECRET) should be stored in AWS SSM Parameter Store
# (SecureString) or Secrets Manager — `setup.sh` puts them under /anot/* — and
# are injected into the Elastic Beanstalk environment as environment properties.
#
# NOTE: Elastic Beanstalk "environment properties" are visible in plaintext in
# the EB console to anyone with access. For stricter handling, read them from
# SSM/Secrets Manager at runtime instead (see README → "Hardening"). The values
# below are still kept out of git.
#
# Copy to env.production and fill in real values for your records. Do NOT commit
# the filled-in file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
# Elastic Beanstalk's Node.js platform sets PORT (8080) and proxies nginx → app.
# src/server.js already reads process.env.PORT and binds 0.0.0.0; do not override.
# PORT=8080
# EB runs the app behind an nginx reverse proxy, so the app trusts 1 hop in
# production automatically (server.js). Leave TRUST_PROXY unset.
# TRUST_PROXY=1

# ── Auth (SECRET) ────────────────────────────────────────────────────────────
# Must be >= 16 chars in production (server.js exits otherwise).
# Generate: openssl rand -base64 48
JWT_SECRET=replace-with-ssm-value
JWT_EXPIRES_IN=1h

# ── Database — Amazon RDS for PostgreSQL ─────────────────────────────────────
# The EB instance reaches RDS over the private VPC network. By default a new RDS
# PostgreSQL instance does NOT force SSL (rds.force_ssl = 0), so the discrete
# DB_* vars connect in plaintext within the VPC, mirroring the private path used
# on Google Cloud. src/config/db.js supports discrete DB_* vars.
DB_HOST=anot-postgres.xxxxxxxxxxxx.ap-southeast-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=anot
DB_USER=anot_app
DB_PASSWORD=replace-with-ssm-value              # (SECRET)
# Set DB_SSL=true ONLY if you connect to RDS publicly / enable rds.force_ssl.
# db.js uses ssl.rejectUnauthorized=true, so you must make Node trust the Amazon
# RDS CA (e.g. NODE_EXTRA_CA_CERTS=/path/to/global-bundle.pem). See README.
# DB_SSL=true
#
# Alternative (single connection string) — overrides the DB_* vars above:
# DATABASE_URL=postgresql://anot_app:PASSWORD@HOST:5432/anot   # (SECRET) requires verifiable TLS

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins. With the recommended setup
# (frontend + /api/* served from the SAME CloudFront distribution) the frontend
# and API share an origin, so CORS is effectively a no-op — but set it anyway.
CORS_ORIGINS=https://dxxxxxxxxxxxxx.cloudfront.net

# ── AI / transcription ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=replace-with-ssm-value          # (SECRET)
DEEPGRAM_API_KEY=replace-with-ssm-value           # (SECRET)
USE_DEEPGRAM=true
DEEPGRAM_MODEL=nova-3-medical
# DEEPGRAM_WEBHOOK_URL=https://your-cloudfront-domain/api/webhooks/deepgram
# DEEPGRAM_WEBHOOK_SECRET=replace-with-ssm-value    # (SECRET)
# DEEPGRAM_TIMEOUT_MS=1800000                       # 30 min max Deepgram job wait
# REQUEST_TIMEOUT=600000                            # 10 min socket timeout (uploads/transcription)
# TRANSCRIPTION_STUCK_MS=1800000                    # Don't reset 'processing' before 30 min
# POLL_INTERVAL=10000                               # 10s between Deepgram status polls

# ── Encryption for stored provider settings ──────────────────────────────────
# Generate: openssl rand -hex 32
SETTINGS_ENCRYPTION_KEY=replace-with-ssm-value     # (SECRET)

# ── Audio storage (S3) ───────────────────────────────────────────────────────
# The backend currently writes uploaded audio to local disk at src/uploads,
# which persists across deploys on a single EB instance. setup.sh provisions an
# S3 bucket for durable storage/backups and grants the EB instance role access
# to it (so you can sync uploads to S3 or wire up an S3 storage backend later).
# These vars are NOT read by the app today; they document the provisioned bucket.
# AUDIO_S3_BUCKET=anot-audio-<account-id>
# AWS_REGION=ap-southeast-1

# ── Error monitoring (optional) ──────────────────────────────────────────────
# Leave unset to use the built-in DSN, set your own, or set empty to silence.
# SENTRY_DSN=

# ── Clinician support email (optional) ───────────────────────────────────────
# SUPPORT_EMAIL=support@anot.health
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=          # (SECRET if set)
# SMTP_FROM=

# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND build-time variable (set when building the Vite app for S3/CloudFront).
# Baked into the static bundle at `npm run build`, not read at runtime.
# With the single-distribution setup, point it at the CloudFront /api path:
#   VITE_API_URL=https://dxxxxxxxxxxxxx.cloudfront.net/api
# ─────────────────────────────────────────────────────────────────────────────
