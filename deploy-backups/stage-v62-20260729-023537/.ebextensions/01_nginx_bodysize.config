files:
  /etc/nginx/conf.d/01_client_max_body_size.conf:
    mode: "000644"
    owner: root
    group: root
    content: |
      client_max_body_size 500m;

container_commands:
  01_verify_nginx_bodysize:
    command: "grep -q 'client_max_body_size 500m' /etc/nginx/conf.d/01_client_max_body_size.conf"
  02_reload_nginx:
    command: "nginx -t && (systemctl reload nginx 2>/dev/null || service nginx reload 2>/dev/null || true)"
