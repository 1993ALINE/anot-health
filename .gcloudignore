# Controls what `gcloud builds submit` (and other gcloud uploads) sends as source.
# Keep the upload small so backend builds are fast.

.git
.gitignore

# Dependencies — reinstalled inside the Docker image
**/node_modules

# Test + report artifacts (can be very large)
test-results
playwright-report
playwright/.cache
coverage

# Local env / secrets
**/.env
**/.env.*
!**/.env.example

# Editor / OS noise
.vscode
.idea
.DS_Store
Thumbs.db
*.log

# Frontend build output (rebuilt during Firebase deploy, not needed by Cloud Build)
anot-frontend-main/anot-frontend-main/dist
