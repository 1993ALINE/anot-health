# Required - Backend API URL
VITE_API_URL=https://api.anot.health/api

# Optional - Override for local development (uncomment to use)
# VITE_API_URL=http://127.0.0.1:5000/api

# Optional - transcription polling for long audio (30+ min recordings)
# VITE_TRANSCRIPTION_POLL_INTERVAL_MS=10000
# VITE_TRANSCRIPTION_MAX_POLL_MS=1800000
# VITE_TRANSCRIPTION_POLL_REQUEST_TIMEOUT_MS=30000
